---
import { getCollection } from 'astro:content';
import { NEBULAE, type ArticleStarDefinition } from '../data/universe';
import { THEME_RGB } from '../data/themes';

const posts = (await getCollection('posts')).sort((a, b) => a.id.localeCompare(b.id));
const articleStars: (ArticleStarDefinition & { published: Date })[] = posts.map((post) => ({
  slug: post.id,
  title: post.data.title,
  subtitle: post.data.description,
  theme: post.data.theme,
  offset: post.data.universe.offset,
  published: post.data.published,
}));

const indexGroups = NEBULAE
  .map((nebula) => ({
    title: nebula.title,
    subtitle: nebula.subtitle,
    rgb: THEME_RGB[nebula.id],
    articles: articleStars.filter((star) => star.theme === nebula.id),
  }))
  .filter((group) => group.articles.length > 0);
---

<div id="universe-shell" class="universe-shell" transition:persist="nebula-universe">
  <canvas id="universe-canvas" aria-label="Interactive nebula universe"></canvas>

  <div id="cursor-glow" class="cursor-glow" aria-hidden="true"></div>

  <nav id="universe-index" class="universe-index" aria-label="Article index">
    <div class="universe-index__scroll">
      {indexGroups.map((group) => (
        <section class="universe-index__group" style={`--star: ${group.rgb};`}>
          <header class="universe-index__head">
            <span class="universe-index__glyph" aria-hidden="true"></span>
            <div>
              <h2 class="universe-index__title">{group.title}</h2>
              <p class="universe-index__subtitle">{group.subtitle}</p>
            </div>
          </header>
          <div class="universe-index__grid">
            {group.articles.map((article) => (
              <a class="universe-index__card" href={`/posts/${encodeURIComponent(article.slug)}`}>
                <p class="universe-index__eyebrow">{article.theme}</p>
                <h3 class="universe-index__name">{article.title}</h3>
                <p class="universe-index__desc">{article.subtitle}</p>
                {article.published && (
                  <time class="universe-index__date" datetime={article.published.toISOString()}>
                    {article.published.toISOString().slice(0, 10)}
                  </time>
                )}
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </nav>

  <nav class="universe-fallback" aria-label="Articles">
    <p>Browse articles directly.</p>
    <div>
      {posts.map((post) => <a href={`/posts/${encodeURIComponent(post.id)}`}>{post.data.title}</a>)}
    </div>
  </nav>

  <div id="universe-vignette" class="universe-vignette" aria-hidden="true"></div>
</div>

<script define:vars={{ articleStars, nebulae: NEBULAE }}>
  window.__NEBULA_CONTENT__ = { articleStars, nebulae };
</script>

<script>
  import { UniverseEngine } from '../lib/universe/UniverseEngine';

  interface NavigationPreparationEvent extends Event {
    from?: URL;
    to?: URL;
    loader?: () => Promise<unknown>;
  }

  const isPostPath = (pathname: string) => pathname.startsWith('/posts/');
  const slugFromPath = (pathname: string) => isPostPath(pathname)
    ? decodeURIComponent(pathname.split('/').filter(Boolean).at(-1) ?? '')
    : null;
  const getRouteKind = () => (isPostPath(location.pathname) ? 'post' : 'home');
  const getRouteSlug = () => slugFromPath(location.pathname);

  const applyFallbackState = () => {
    const route = getRouteKind();
    document.documentElement.dataset.pageKind = route;
    document.documentElement.dataset.universeUnavailable = 'true';
    document.documentElement.dataset.universeState = route === 'home' ? 'cover' : 'article';
  };

  const boot = () => {
    const shell = document.querySelector<HTMLElement>('#universe-shell');
    if (!shell || !window.__NEBULA_CONTENT__) return;
    if (window.__nebulaUniverseUnavailable) {
      applyFallbackState();
      return;
    }

    if (!window.__nebulaUniverse) {
      try {
        window.__nebulaUniverse = new UniverseEngine(shell, {
          content: window.__NEBULA_CONTENT__,
          initialRoute: getRouteKind(),
          initialSlug: getRouteSlug(),
        });
        delete document.documentElement.dataset.universeUnavailable;
        window.__nebulaUniverse.start();
      } catch (error) {
        console.error('Nebula universe could not start; using the content fallback.', error);
        window.__nebulaUniverseUnavailable = true;
        applyFallbackState();
        return;
      }
    }

    window.__nebulaUniverse.handleRoute(getRouteKind(), getRouteSlug());
  };

  const wireNavigationGuard = () => {
    if (window.__nebulaNavigationGuardWired) return;
    window.__nebulaNavigationGuardWired = true;

    document.addEventListener('astro:before-preparation', (rawEvent) => {
      const event = rawEvent as NavigationPreparationEvent;
      const engine = window.__nebulaUniverse;
      if (!engine || !event.from || !event.to || typeof event.loader !== 'function') return;

      const fromPost = isPostPath(event.from.pathname);
      const toPost = isPostPath(event.to.pathname);
      if (fromPost === toPost) return;

      const originalLoader = event.loader;
      const fromRoute = fromPost ? 'post' : 'home';
      const fromSlug = slugFromPath(event.from.pathname);
      if (!fromPost && toPost) {
        const slug = slugFromPath(event.to.pathname);
        if (!slug) return;
        event.loader = async () => {
          // Fetch concurrently with the fly-in so the network wait hides inside the animation.
          const loading = originalLoader();
          loading.catch(() => {});
          try {
            await engine.prepareEntry(slug);
            await loading;
          } catch (error) {
            engine.recoverNavigationFailure(fromRoute, fromSlug);
            throw error;
          }
        };
        return;
      }

      if (fromPost && !toPost) {
        event.loader = async () => {
          // Same overlap for the return: home document loads during the reverse animation.
          const loading = originalLoader();
          loading.catch(() => {});
          try {
            await engine.prepareReturn(fromSlug);
            await loading;
          } catch (error) {
            engine.recoverNavigationFailure(fromRoute, fromSlug);
            throw error;
          }
        };
      }
    });
  };

  wireNavigationGuard();
  boot();
  if (!window.__nebulaPageLoadWired) {
    window.__nebulaPageLoadWired = true;
    // after-swap runs before the new page is painted; re-assert the persistent engine
    // state immediately so route-level CSS never sees a transient state-less document.
    document.addEventListener('astro:after-swap', boot);
    document.addEventListener('astro:page-load', boot);
  }
</script>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif;
    background: #02030a;
    color: #f6f7ff;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
  }

  * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; background: #02030a; }
  body { min-height: 100vh; overflow-x: hidden; }

  .universe-shell {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: radial-gradient(circle at 50% 42%, rgba(21, 27, 58, 0.16), transparent 42%), #02030a;
  }

  #universe-canvas { position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; display: block; outline: none; }

  .cursor-glow {
    z-index: 2;
    --x: 50vw;
    --y: 50vh;
    position: fixed;
    left: var(--x);
    top: var(--y);
    width: 14rem;
    height: 14rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(circle, rgba(238,246,255,.13) 0%, rgba(147,183,255,.06) 26%, transparent 68%);
    filter: blur(8px);
    transition: opacity .35s ease;
    mix-blend-mode: screen;
  }

  /* ── Article index (cosmos state) ─────────────────────────────── */

  .universe-index {
    position: fixed;
    z-index: 2;
    inset: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(16px);
    transition: opacity .45s ease, transform .7s cubic-bezier(.2,.8,.2,1), visibility 0s linear .45s;
  }

  html[data-page-kind="home"][data-universe-state="cosmos"] .universe-index {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
    transition-delay: 0s;
  }

  .universe-index__scroll {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    gap: 44px;
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 110px max(24px, 6vw) 76px;
  }

  .universe-index__group:first-child { margin-top: auto; }
  .universe-index__group:last-child { margin-bottom: auto; }

  .universe-index__group { --star: 154,182,255; }

  .universe-index__head { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }
  .universe-index__glyph {
    flex: none;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: rgb(var(--star));
    box-shadow: 0 0 14px 3px rgba(var(--star), .5);
  }
  .universe-index__title {
    margin: 0;
    font-weight: 400;
    font-size: 12px;
    letter-spacing: .3em;
    color: rgba(240,246,255,.9);
  }
  .universe-index__subtitle { margin: 3px 0 0; font-size: 10px; letter-spacing: .08em; color: rgba(225,233,255,.4); }

  .universe-index__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; }

  .universe-index__card {
    display: block;
    padding: 18px 20px 15px;
    border: 1px solid rgba(var(--star), .16);
    border-left: 2px solid rgba(var(--star), .55);
    border-radius: 12px;
    background: linear-gradient(160deg, rgba(10,14,30,.66), rgba(6,8,18,.48));
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    text-decoration: none;
    transition: border-color .25s ease, box-shadow .25s ease, transform .25s ease;
  }
  .universe-index__card:hover {
    border-color: rgba(var(--star), .5);
    box-shadow: 0 0 28px -6px rgba(var(--star), .35);
    transform: translateY(-3px);
  }
  .universe-index__eyebrow {
    margin: 0 0 9px;
    font-size: 9px;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: rgba(var(--star), .92);
  }
  .universe-index__name {
    margin: 0;
    font: 400 clamp(19px, 1.8vw, 24px)/1.3 Georgia, 'Times New Roman', 'Noto Serif SC', 'Source Han Serif SC', SimSun, serif;
    color: rgba(248,250,255,.95);
  }
  .universe-index__desc { margin: 9px 0 12px; font-size: 12.5px; line-height: 1.65; color: rgba(226,233,247,.55); }
  .universe-index__date { font-size: 10px; letter-spacing: .1em; color: rgba(222,229,247,.32); }

  .universe-fallback {
    position: fixed;
    z-index: 2;
    left: 50%;
    bottom: 34px;
    width: min(760px, calc(100vw - 40px));
    transform: translateX(-50%);
    display: none;
    text-align: center;
    color: rgba(226,233,255,.56);
  }
  .universe-fallback p { margin: 0 0 14px; font-size: 10px; letter-spacing: .08em; }
  .universe-fallback div { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 18px; }
  .universe-fallback a { color: rgba(239,243,255,.76); font: 400 14px/1.5 Georgia, 'Times New Roman', serif; text-decoration: none; }
  .universe-fallback a:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
  html[data-universe-unavailable="true"][data-page-kind="home"] .universe-fallback { display: block; }
  html[data-universe-unavailable="true"] #universe-canvas { opacity: 0; }

  .universe-vignette {
    position: fixed;
    z-index: 1;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at center, transparent 40%, rgba(0,0,8,.2) 76%, rgba(0,0,8,.68) 100%);
    opacity: .66;
  }

  html[data-universe-state="article-return"] .article-page {
    animation: none;
    opacity: 0;
    transform: scale(.992);
    pointer-events: none;
  }

  @media (max-width: 720px) {
    .universe-index__scroll { padding: 88px 18px 56px; gap: 36px; }
    .universe-index__card { backdrop-filter: none; -webkit-backdrop-filter: none; }
    .universe-index__grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .universe-index, .cursor-glow { transition-duration: 0.01ms !important; }
  }
</style>
