---
import { getCollection } from 'astro:content';
import { NEBULAE, type ArticleStarDefinition } from '../data/universe';
import { THEME_RGB } from '../data/themes';

const posts = (await getCollection('posts')).sort((a, b) => a.id.localeCompare(b.id));
const articleStars: (ArticleStarDefinition & { published: Date })[] = posts.map((post) => ({
  slug: post.id,
  title: post.data.title,
  subtitle: post.data.description,
  theme: post.data.theme,
  offset: post.data.universe.offset,
  published: post.data.published,
}));

const indexArticles = [...articleStars].sort((a, b) => b.published.getTime() - a.published.getTime());
const legendThemes = NEBULAE.map((nebula) => ({
  title: nebula.title,
  rgb: THEME_RGB[nebula.id],
}));
---

<div id="universe-shell" class="universe-shell" transition:persist="nebula-universe">
  <canvas id="universe-canvas" aria-label="Interactive nebula universe"></canvas>

  <div id="cursor-glow" class="cursor-glow" aria-hidden="true"></div>

  <nav id="universe-index" class="universe-index" aria-label="Article index">
    <div class="universe-index__scroll">
      <header class="universe-index__head">
        <span class="universe-index__headtitle">Field Notes</span>
        <span class="universe-index__legend">
          {legendThemes.map((theme) => (
            <span class="universe-index__legend-item" style={`--star: ${theme.rgb};`}>
              <i></i>{theme.title}
            </span>
          ))}
        </span>
      </header>
      {indexArticles.map((article, index) => (
        <a
          class="universe-index__card"
          style={`--star: ${THEME_RGB[article.theme]};`}
          href={`/posts/${encodeURIComponent(article.slug)}`}
        >
          <span class="universe-index__node" aria-hidden="true"></span>
          <span class="universe-index__body">
            <span class="universe-index__meta">
              <span class="universe-index__no">{String(index + 1).padStart(2, '0')}</span>
              <span class="universe-index__theme">{article.theme}</span>
              <time class="universe-index__date" datetime={article.published.toISOString()}>
                {article.published.toISOString().slice(0, 10)}
              </time>
            </span>
            <span class="universe-index__name">{article.title}</span>
            <span class="universe-index__desc">{article.subtitle}</span>
          </span>
        </a>
      ))}
    </div>
  </nav>

  <nav class="universe-fallback" aria-label="Articles">
    <p>Browse articles directly.</p>
    <div>
      {posts.map((post) => <a href={`/posts/${encodeURIComponent(post.id)}`}>{post.data.title}</a>)}
    </div>
  </nav>

  <div id="universe-vignette" class="universe-vignette" aria-hidden="true"></div>
</div>

<script define:vars={{ articleStars, nebulae: NEBULAE }}>
  window.__NEBULA_CONTENT__ = { articleStars, nebulae };
</script>

<script>
  import { UniverseEngine } from '../lib/universe/UniverseEngine';

  interface NavigationPreparationEvent extends Event {
    from?: URL;
    to?: URL;
    loader?: () => Promise<unknown>;
  }

  const isPostPath = (pathname: string) => pathname.startsWith('/posts/');
  const slugFromPath = (pathname: string) => isPostPath(pathname)
    ? decodeURIComponent(pathname.split('/').filter(Boolean).at(-1) ?? '')
    : null;
  const getRouteKind = () => (isPostPath(location.pathname) ? 'post' : 'home');
  const getRouteSlug = () => slugFromPath(location.pathname);

  const applyFallbackState = () => {
    const route = getRouteKind();
    document.documentElement.dataset.pageKind = route;
    document.documentElement.dataset.universeUnavailable = 'true';
    document.documentElement.dataset.universeState = route === 'home' ? 'cover' : 'article';
  };

  const boot = () => {
    const shell = document.querySelector<HTMLElement>('#universe-shell');
    if (!shell || !window.__NEBULA_CONTENT__) return;
    if (window.__nebulaUniverseUnavailable) {
      applyFallbackState();
      return;
    }

    if (!window.__nebulaUniverse) {
      try {
        window.__nebulaUniverse = new UniverseEngine(shell, {
          content: window.__NEBULA_CONTENT__,
          initialRoute: getRouteKind(),
          initialSlug: getRouteSlug(),
        });
        delete document.documentElement.dataset.universeUnavailable;
        window.__nebulaUniverse.start();
      } catch (error) {
        console.error('Nebula universe could not start; using the content fallback.', error);
        window.__nebulaUniverseUnavailable = true;
        applyFallbackState();
        return;
      }
    }

    window.__nebulaUniverse.handleRoute(getRouteKind(), getRouteSlug());
  };

  const wireNavigationGuard = () => {
    if (window.__nebulaNavigationGuardWired) return;
    window.__nebulaNavigationGuardWired = true;

    document.addEventListener('astro:before-preparation', (rawEvent) => {
      const event = rawEvent as NavigationPreparationEvent;
      const engine = window.__nebulaUniverse;
      if (!engine || !event.from || !event.to || typeof event.loader !== 'function') return;

      const fromPost = isPostPath(event.from.pathname);
      const toPost = isPostPath(event.to.pathname);
      if (fromPost === toPost) return;

      const originalLoader = event.loader;
      const fromRoute = fromPost ? 'post' : 'home';
      const fromSlug = slugFromPath(event.from.pathname);
      if (!fromPost && toPost) {
        const slug = slugFromPath(event.to.pathname);
        if (!slug) return;
        event.loader = async () => {
          // Fetch concurrently with the fly-in so the network wait hides inside the animation.
          const loading = originalLoader();
          loading.catch(() => {});
          try {
            await engine.prepareEntry(slug);
            await loading;
          } catch (error) {
            engine.recoverNavigationFailure(fromRoute, fromSlug);
            throw error;
          }
        };
        return;
      }

      if (fromPost && !toPost) {
        event.loader = async () => {
          // Same overlap for the return: home document loads during the reverse animation.
          const loading = originalLoader();
          loading.catch(() => {});
          try {
            await engine.prepareReturn(fromSlug);
            await loading;
          } catch (error) {
            engine.recoverNavigationFailure(fromRoute, fromSlug);
            throw error;
          }
        };
      }
    });
  };

  wireNavigationGuard();
  boot();
  if (!window.__nebulaPageLoadWired) {
    window.__nebulaPageLoadWired = true;
    // after-swap runs before the new page is painted; re-assert the persistent engine
    // state immediately so route-level CSS never sees a transient state-less document.
    document.addEventListener('astro:after-swap', boot);
    document.addEventListener('astro:page-load', boot);
  }
</script>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif;
    background: #02030a;
    color: #f6f7ff;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
  }

  * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; background: #02030a; }
  body { min-height: 100vh; overflow-x: hidden; }

  .universe-shell {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: radial-gradient(circle at 50% 42%, rgba(21, 27, 58, 0.16), transparent 42%), #02030a;
  }

  #universe-canvas { position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; display: block; outline: none; }

  .cursor-glow {
    z-index: 2;
    --x: 50vw;
    --y: 50vh;
    position: fixed;
    left: var(--x);
    top: var(--y);
    width: 14rem;
    height: 14rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(circle, rgba(238,246,255,.13) 0%, rgba(147,183,255,.06) 26%, transparent 68%);
    filter: blur(8px);
    transition: opacity .35s ease;
    mix-blend-mode: screen;
  }

  /* ── Article index (cosmos state): observational log over the raw nebula ── */

  .universe-index {
    position: fixed;
    z-index: 2;
    inset: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(16px);
    transition: opacity .45s ease, transform .7s cubic-bezier(.2,.8,.2,1), visibility 0s linear .45s;
  }

  html[data-page-kind="home"][data-universe-state="cosmos"] .universe-index {
    visibility: visible;
    pointer-events: auto;
    animation: universe-index-in .55s cubic-bezier(.25,.7,.25,1) both;
  }

  @keyframes universe-index-in {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }

  /* Deepen the vignette while reading so type floats over the raw nebula. */
  html[data-page-kind="home"][data-universe-state="cosmos"] .universe-vignette {
    background: radial-gradient(circle at center, rgba(2,3,10,.42) 26%, rgba(0,0,8,.62) 62%, rgba(0,0,8,.85) 100%);
  }

  .universe-index__scroll {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 920px;
    margin: 0 auto;
    padding: 96px clamp(20px, 7vw, 84px) 72px;
  }

  .universe-index__head {
    margin-top: auto;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    padding: 0 0 18px 34px;
    border-bottom: 1px solid rgba(233,239,255,.14);
  }

  .universe-index__headtitle {
    font-size: 11px;
    letter-spacing: .42em;
    text-transform: uppercase;
    color: rgba(236,242,255,.72);
  }

  .universe-index__legend { display: flex; gap: 16px; flex-wrap: wrap; }
  .universe-index__legend-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 9px;
    letter-spacing: .22em;
    color: rgba(225,233,255,.42);
    --star: 154,182,255;
  }
  .universe-index__legend-item i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgb(var(--star));
    box-shadow: 0 0 8px 1px rgba(var(--star), .6);
  }

  .universe-index__card:last-of-type { margin-bottom: auto; }

  /* Each entry: a log row hung on a shared constellation spine. */
  .universe-index__card {
    --star: 154,182,255;
    position: relative;
    display: grid;
    grid-template-columns: 34px 1fr;
    padding: 20px 10px 18px 0;
    text-decoration: none;
  }

  .universe-index__card::before {
    /* spine segment */
    content: '';
    position: absolute;
    left: 5px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgba(233,239,255,.1);
  }
  .universe-index__card:first-of-type::before { top: 28px; }
  .universe-index__card:last-of-type::before { bottom: auto; height: 28px; }

  .universe-index__node {
    position: absolute;
    left: 0;
    top: 25px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: rgb(var(--star));
    box-shadow: 0 0 12px 2px rgba(var(--star), .55);
    transition: box-shadow .25s ease, transform .25s ease;
  }

  .universe-index__body { grid-column: 2; min-width: 0; transition: transform .3s cubic-bezier(.2,.8,.2,1); }

  .universe-index__meta {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 7px;
  }

  .universe-index__no {
    font-size: 10px;
    letter-spacing: .18em;
    color: rgba(225,233,255,.26);
    font-variant-numeric: tabular-nums;
  }

  .universe-index__theme {
    font-size: 9px;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: rgba(var(--star), .9);
  }

  .universe-index__date {
    margin-left: auto;
    font-size: 10px;
    letter-spacing: .12em;
    color: rgba(222,229,247,.34);
    font-variant-numeric: tabular-nums;
  }

  .universe-index__name {
    display: block;
    font: 400 clamp(20px, 2.1vw, 27px)/1.32 Georgia, 'Times New Roman', 'Noto Serif SC', 'Source Han Serif SC', SimSun, serif;
    letter-spacing: .01em;
    color: rgba(246,248,255,.94);
    text-shadow: 0 1px 18px rgba(0,0,6,.8);
    transition: color .25s ease;
  }

  .universe-index__desc {
    display: block;
    margin-top: 7px;
    font-size: 12.5px;
    line-height: 1.7;
    color: rgba(224,231,246,.5);
    max-width: 62ch;
    text-shadow: 0 1px 14px rgba(0,0,6,.8);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Newest entry is the headline of the log. */
  .universe-index__card:first-of-type .universe-index__name {
    font-size: clamp(28px, 3.4vw, 42px);
    line-height: 1.18;
  }
  .universe-index__card:first-of-type .universe-index__desc { color: rgba(228,234,248,.62); }
  .universe-index__card:first-of-type .universe-index__node {
    width: 14px;
    height: 14px;
    left: -1.5px;
  }

  .universe-index__card:hover .universe-index__name { color: #fff; }
  .universe-index__card:hover .universe-index__body { transform: translateX(9px); }
  .universe-index__card:hover .universe-index__node {
    box-shadow: 0 0 20px 5px rgba(var(--star), .8);
    transform: scale(1.25);
  }

  .universe-fallback {
    position: fixed;
    z-index: 2;
    left: 50%;
    bottom: 34px;
    width: min(760px, calc(100vw - 40px));
    transform: translateX(-50%);
    display: none;
    text-align: center;
    color: rgba(226,233,255,.56);
  }
  .universe-fallback p { margin: 0 0 14px; font-size: 10px; letter-spacing: .08em; }
  .universe-fallback div { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 18px; }
  .universe-fallback a { color: rgba(239,243,255,.76); font: 400 14px/1.5 Georgia, 'Times New Roman', serif; text-decoration: none; }
  .universe-fallback a:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
  html[data-universe-unavailable="true"][data-page-kind="home"] .universe-fallback { display: block; }
  html[data-universe-unavailable="true"] #universe-canvas { opacity: 0; }

  .universe-vignette {
    position: fixed;
    z-index: 1;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at center, transparent 40%, rgba(0,0,8,.2) 76%, rgba(0,0,8,.68) 100%);
    opacity: .66;
  }

  html[data-universe-state="article-return"] .article-page {
    animation: none;
    opacity: 0;
    transform: scale(.992);
    pointer-events: none;
  }

  @media (max-width: 720px) {
    .universe-index__scroll { padding: 78px 18px 54px; }
    .universe-index__head { padding-left: 34px; gap: 10px 14px; }
    .universe-index__card { grid-template-columns: 26px 1fr; padding-top: 16px; padding-bottom: 14px; }
    .universe-index__card::before { left: 4px; }
    .universe-index__card:first-of-type::before { top: 24px; }
    .universe-index__card:last-of-type::before { height: 24px; }
    .universe-index__node { top: 21px; }
    .universe-index__date { display: none; }
    .universe-index__desc { -webkit-line-clamp: 2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .universe-index { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
    .cursor-glow { transition-duration: 0.01ms !important; }
  }
</style>
